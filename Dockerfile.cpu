FROM nvidia/cuda:12.8.1-devel-ubuntu24.04

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    wget \
    ca-certificates \
    gzip \
    tar \
    && rm -rf /var/lib/apt/lists/*

# Install ArrayFire
RUN wget -nv -O /tmp/arrayfire.sh \
    "https://arrayfire.gateway.scarf.sh/linux/3.10.0/ArrayFire.sh" \
    && bash /tmp/arrayfire.sh \
    --skip-license \
    --prefix=/opt \
    --include-subdir \
    && rm /tmp/arrayfire.sh

ENV CMAKE_PREFIX_PATH=/opt/ArrayFire-3.10.0-Linux

WORKDIR /workspace

# Download MNIST test data
RUN mkdir -p data/mnist && cd data/mnist \
    && wget -nv https://storage.googleapis.com/cvdf-datasets/mnist/train-images-idx3-ubyte.gz \
    && wget -nv https://storage.googleapis.com/cvdf-datasets/mnist/train-labels-idx1-ubyte.gz \
    && wget -nv https://storage.googleapis.com/cvdf-datasets/mnist/t10k-images-idx3-ubyte.gz \
    && wget -nv https://storage.googleapis.com/cvdf-datasets/mnist/t10k-labels-idx1-ubyte.gz \
    && gzip -d *.gz \
    && mv train-images-idx3-ubyte train-images.idx3-ubyte \
    && mv train-labels-idx1-ubyte train-labels.idx1-ubyte \
    && mv t10k-images-idx3-ubyte t10k-images.idx3-ubyte \
    && mv t10k-labels-idx1-ubyte t10k-labels.idx1-ubyte

# Download CIFAR-10 test data
RUN mkdir -p data/cifar10 \
    && wget -nv -O /tmp/cifar-10-binary.tar.gz \
    https://www.cs.toronto.edu/~kriz/cifar-10-binary.tar.gz \
    && tar -xzf /tmp/cifar-10-binary.tar.gz \
    -C data/cifar10 --strip-components=1 \
    && rm /tmp/cifar-10-binary.tar.gz

COPY . .

# Configure CPU backend
RUN cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DNEURO_BACKEND=CPU \
    -DNEURO_BUILD_EXAMPLES=ON \
    -DNEURO_BUILD_TESTS=ON

# Build
RUN cmake --build build --parallel 2

# Execute tests
RUN ctest --test-dir build --output-on-failure --no-tests=error